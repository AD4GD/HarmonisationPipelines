<#measures> a rr:TriplesMap; 

rml:logicalSource [
	rml:source "";   # variable with path to the csv auxiliary file
	rml:referenceFormulation ql:CSV;

];
rr:subjectMap [
  rr:termType rr:BlankNode;

];
rr:predicateObjectMap [
    rr:predicateMap [ rr:constant qb:measure ];
    rr:objectMap [
			rr:parentTriplesMap <measures_ns>;   #variable with a package name and slices i.e. <#year.country.tf_gen1.tf_prin2.tf_subp4.measures>
		]
].