@prefix unit: <http://qudt.org/vocab/unit/> .


##################### Parcel Perimeter #####################

<#filename_parcel_perimeter>   # variable ns
    rr:logicalTable [ rr:tableName "`{filename}`"; ];   # variable
    rr:subjectMap [ rr:class qudt:QuantityValue; rr:template "{temp_parcel_perimeter}"; ];   # variable

    rr:predicateObjectMap [
        rr:predicate qudt:numericValue;
        rr:objectMap [
            rr:datatype xsd:double;
            rr:column "`{column_perim}`";   # variable
        ];
    ];
    rr:predicateObjectMap [
        rr:predicate qudt:unit;
        rr:objectMap [
            rr:constant <http://qudt.org/vocab/unit/M> ;
        ];
    ];
    .