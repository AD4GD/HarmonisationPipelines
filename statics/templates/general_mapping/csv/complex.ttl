<#filename_secondary> rml:logicalSource [
	rml:source "{file_path}";
	rml:referenceFormulation ql:CSV;
	rml:iterator "{filename}";
];

rr:predicateObjectMap [];

rr:subjectMap [
	rr:template "{template}";
	rr:class "{type}";
] .